# Postgres (docker compose exposes it on 5433 to avoid clashing with a local server)
DATABASE_URL=postgres://llmpense:llmpense@localhost:5433/llmpense

# Proxy
PROXY_PORT=8787
OPENAI_BASE_URL=https://api.openai.com
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Web
# Extra hosts allowed to use the dev server, e.g. your machine's LAN IP to test on a phone
DEV_ORIGINS=
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-to-32-random-bytes
