# Postgres for `pnpm dev` (docker compose exposes it on localhost:5433 to avoid clashing with a
# local server). The full docker compose stack sets its own DATABASE_URL.
DATABASE_URL=postgres://llmpense:llmpense@localhost:5433/llmpense

# Proxy
PROXY_PORT=8787
OPENAI_BASE_URL=https://api.openai.com
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Web
# Extra hosts allowed to use the dev server, e.g. your machine's LAN IP to test on a phone
DEV_ORIGINS=
# Dashboard login. Leave empty to open the dashboard without a password; only do that
# when nobody else can reach the server. If you set one, also set SESSION_SECRET (16+ chars).
ADMIN_PASSWORD=
SESSION_SECRET=
# Optional: HMAC key of your Helicone webhook. When set, /api/v1/integrations/helicone
# rejects requests without a valid helicone-signature header.
HELICONE_WEBHOOK_SECRET=
# Exchange rates: the dashboard fetches ECB reference rates at most once a day when the stored
# ones are older than today. Set to 0 on offline installs and use manual rates or `pnpm fx:sync`.
FX_AUTO_FETCH=

# Docker compose (full stack). Set POSTGRES_PASSWORD before the first start; the database keeps
# the password it was created with. Ports are the host ports for the dashboard and the proxy.
POSTGRES_PASSWORD=
WEB_PORT=
# Public URLs shown in the setup snippets, e.g. https://llmpense.example.com behind HTTPS.
APP_PUBLIC_URL=
PROXY_PUBLIC_URL=
